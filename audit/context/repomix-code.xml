RESULTS_DIR = REPO_ROOT / "results" / "joint_diagnostic"
HELD_OUT: Tuple[int, ...] = (6, 7, 8, 9)
GATE_THRESHOLD = 40.0          # within-modality 6-9 probe confound gate (%)
SEEDS_FULL: List[int] = [42, 123, 456]
