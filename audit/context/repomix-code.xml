def get_nmnist_loaders(batch_size=32, num_workers=2):
    print("\n🔄 Loading N-MNIST...")
    
    sensor_size = tonic.datasets.NMNIST.sensor_size
    print(f"   Sensor size: {sensor_size}")
    
    transform = tonic.transforms.Compose([
