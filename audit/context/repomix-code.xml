    def prep(W, b):
        Wt = torch.from_numpy(W).to(device=device, dtype=torch.float32)
        bt = torch.from_numpy(b).to(device=device, dtype=torch.float32)
        Ws = Wt * scale
        mask = torch.abs(Ws) > 0.001
        Ws = Ws * mask
        return Ws, bt * 10.0

