        'energy':  RESULTS_DIR / 'energy_results.json',
    }
    for key, path in files.items():
        if path.exists():
            if path.suffix == '.csv':
                out[key] = pd.read_csv(path)
                print(f"  ✅ {key:12s} ({len(out[key])} rows)")
