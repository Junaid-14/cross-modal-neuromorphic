CONFIG = {
    'batch_size': 32,
    'learning_rate': 1e-3,
    'weight_decay': 1e-4,
    'max_epochs': 30,
    'patience': 5,
    'gradient_clip': 1.0,
    'beta': 0.9,
    'dropout': 0.2,
