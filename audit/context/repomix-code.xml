    # Final accuracies
    acc_vis_all = _accuracy_on_all(model, loaders["nmnist"]["test"], "visual", device)
    acc_aud_all = _accuracy_on_all(model, loaders["shd"]["test"], "audio", device)
    probe = _within_modality_probe(model, loaders, device)

