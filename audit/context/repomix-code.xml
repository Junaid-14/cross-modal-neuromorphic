    if cfg.align_cross_modal and "paired" in data_loaders:
        print("\n🔗 ALIGNMENT: cross-modal SupCon on shared subspace")
        align_history = trainer.align_cross_modal(
            paired_loader=data_loaders["paired"],
            num_epochs=5,
            lr=cfg.lr,
