def load_results():
    """Load all result CSVs, return unified dict."""
    out = {}
    files = {
        'cl':      RESULTS_DIR / 'cl_results.csv',
        'ewc':     RESULTS_DIR / 'ewc_results.csv',
        'joint':   RESULTS_DIR / 'joint_results.csv',
