    acc_t3_after = trainer.evaluate(data_loaders[task3]["test"], task3, task3)
    print(f"   T3 Test: {acc_t3_after:.2f}%")

    # Re-evaluate T1 and T2 after T3
    acc_t1_after_t3 = trainer.evaluate(data_loaders[task1]["test"], task1, task1)
