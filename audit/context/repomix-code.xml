        "T2_sil_vis": transfer_after_t2["sil_visual"],
        "T2_sil_aud": transfer_after_t2["sil_audio"],
    }

    _save_seed_result(result, cfg, results_dir)
    return result


# ═══════════════════════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════════════════════

def main():
