    print(f"\n🚨 ALERT: N-MNIST accuracy {nmnist_test_acc:.2f}% is at or below chance ({CHANCE_NMNIST:.1f}%)")
    raise RuntimeError("N-MNIST single-task accuracy below chance — aborting.")
elif nmnist_test_acc < 80.0:
