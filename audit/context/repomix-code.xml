    alpha_v = np.exp(-dt / 20.0)
    alpha_ie = np.exp(-dt / 5.0)
    v_factor = 20.0 * (1.0 - alpha_v)
    cross_factor = (20.0 * 5.0 / 15.0) * (alpha_v - alpha_ie)
