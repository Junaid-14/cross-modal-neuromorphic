    # Forgetting metrics
    forgetting_t1_t2 = acc_t1_after - acc_t1_after_t2
    forgetting_t1_t3 = acc_t1_after_t2 - acc_t1_after_t3
    forgetting_t2_t3 = acc_t2_after - acc_t2_after_t3

    result = {
