def _build_test_loaders(cfg: ExperimentConfig):
    """Build only the test loaders needed for retention checks (skip slow SHD train)."""
    data_dir = Path("./ICONS_M7/datasets")
    data_dir.mkdir(parents=True, exist_ok=True)

