    print(f"   T1 after T2: {acc_t1_after_t2:.2f}%")

    # Sanity printout for T2
    learning_gain_t2 = acc_t2_after - acc_t2_zero_shot
    fwt_t2 = acc_t2_zero_shot - random_init_baselines[task2]
    print_task_sanity(
