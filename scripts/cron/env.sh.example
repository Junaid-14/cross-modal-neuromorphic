# Copy to env.sh and fill in. env.sh is gitignored — never commit your API key.
#   cp scripts/cron/env.sh.example scripts/cron/env.sh && $EDITOR scripts/cron/env.sh

# Anthropic API key. Interactive OAuth does NOT work under cron/launchd, so a key is required.
export ANTHROPIC_API_KEY="sk-ant-..."

# Absolute path to the claude binary. Find yours with: which claude
export CLAUDE_BIN="/opt/homebrew/bin/claude"

# Absolute path to this repo (the parent of scripts/).
export REPO="/Users/zainhassan/Documents/cross-modal-neuromorphic"

# Where wrapper run-logs (JSON + stderr) are written.
export LOGDIR="$REPO/scripts/cron/logs"

# launchd starts with a minimal PATH; make sure claude + git + gh + osascript resolve.
export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
